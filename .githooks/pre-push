#!/usr/bin/env bash
# Refuse to push any commit that has not passed the INVERSO quality gate (Abismo/check.sh).
# git gives one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>.
root="$(git rev-parse --show-toplevel)"
stamp="$root/Abismo/build-check-logs/passed-commit"
passed="$(cat "$stamp" 2>/dev/null)"
zero=0000000000000000000000000000000000000000
status=0
while read -r localRef localSha remoteRef remoteSha; do
 [ "$localSha" = "$zero" ] && continue # deleting a remote ref
 if [ "$localSha" != "$passed" ]; then
  echo "pre-push: $localSha ($localRef) has not passed Abismo/check.sh; check out that commit and run it"
  status=1
 fi
done
[ $status = 0 ] || echo "pre-push: push refused"
exit $status
